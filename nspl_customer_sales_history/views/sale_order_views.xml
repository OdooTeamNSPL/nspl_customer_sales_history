<odoo>
    <record id="view_order_form_inherit_customer_history" model="ir.ui.view">
        <field name="name">sale.order.form.customer.history.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button name="action_open_customer_sales_history"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-history"
                        groups="nspl_customer_sales_history.group_customer_sales_history_user">
                    <div class="o_stat_info">
                        <span>Sales History</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
